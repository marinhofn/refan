# Refan — Configuração de ambiente
# Copie este arquivo para .env e preencha os valores.
# .env está no .gitignore e nunca deve ser commitado.

# --- Ollama (LLM local) ---
REFAN_LLM_MODEL=mistral
# REFAN_NUM_GPU_LAYERS=60  # Opcional: forçar camadas na GPU

# --- Supabase (cloud persistence — opcional) ---
# Deixe vazio para rodar em modo local-only (JSONL + CSV).
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# --- Runner ---
REFAN_RUNNER_ID=desktop-rtx4070
REFAN_PROMPT_VERSION=v2.0-mestrado
