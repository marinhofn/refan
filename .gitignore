# =====================
# Projeto Refan - .gitignore
# Ajuste conforme necessidade. Remova entradas se quiser versioná-las.
# =====================

# Python bytecode & metadata
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg-info/
*.egg

# Virtual environments
.venv/
venv/
ENV/

# Ferramentas / IDE
.vscode/
.idea/
*.code-workspace

# Logs e temporários
*.log
*.tmp
*.swp
*.swo
*.orig
*.bak

# Arquivos de análise gerados / resultados
output/
temp_diffs/

# Falhas de parsing JSON (gerado, pode crescer sem limite)
json_failures.json
json_failures.jsonl

# Repositórios externos clonados (reconstruíveis)
repositorios/

# Arquivos de análise unificada (derivados, reconstruíveis)
complete_unified_analysis.*

# Backups de CSV com timestamp
csv/*.backup_*
csv/llm_analysis_csv/

# Dados derivados (ajuste se algum for fonte primária)
/data/

# Cache de testes / ferramentas
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/
.dist/
build/
dist/

# Notebooks temporários
.ipynb_checkpoints/

# Sistema
.DS_Store
Thumbs.db

# Artefatos de conflito de sincronização (iCloud/Finder duplica como "nome 2.ext").
# Em jul/2026 esses artefatos violaram o baseline imutável (EVOLUTION_PLAN.md, INT-1/INT-2);
# a CI executa scripts/data/check_repo_hygiene.py para impedir que sejam versionados.
* 2
* 2.*
* 2/

# Arquivos que podem conter segredos (verifique antes de remover este ignore)
*.env
.env.*
!.env.example
secrets*/

# Modelos adicionais (caso algum dia salvar pesos locais)
# models/

# Documentação de planejamento (local, não versionada)
ARCHITECTURE_PLAN.md
REFACTORING_PLAN.md

# Claude Code
.claude/

# TCC / documentos acadêmicos
*.pdf
# Exceção: o PDF do TCC dentro do baseline faz parte do snapshot versionado
!baseline_tcc_2025/**/*.pdf

# Baseline imutável do TCC: versionado via Git LFS desde a Fase H7
# (HARDENING_PLAN.md) com integridade atestada por MANIFEST.sha256.
